# ATTESTATSIYA.UZ - Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-very-strong-secret-key

# Database Connection (Default: SQLite, or MariaDB/MySQL)
