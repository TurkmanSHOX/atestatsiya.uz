DATABASE_URL=sqlite:///attestatsiya.db
# MariaDB (HeidiSQL):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/attestatsiya_uz?charset=utf8mb4

# Server Config
HOST=0.0.0.0
PORT=5000
