# ATTESTATSIYA.UZ 2.0 - Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=attestatsiya-super-secure-production-key-2026-uzb

# Ma'lumotlar bazasi (Lokal sinov uchun SQLite, yoki MariaDB)
# SQLite:
DATABASE_URL=sqlite:///attestatsiya.db
# MariaDB (HeidiSQL):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/attestatsiya_uz?charset=utf8mb4

# Server port va host
HOST=0.0.0.0
PORT=5000

# Click To'lov Tizimi
CLICK_MERCHANT_ID=test_merchant_id
CLICK_SERVICE_ID=test_service_id
CLICK_SECRET_KEY=test_secret_key

# Telegram Admin Xabarnoma Boti
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# AI Sozlamalari (Ixtiyoriy)
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_ENABLED=true
